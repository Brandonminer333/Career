---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import cfg from '../../../config.json';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>

	<div id="content">
		<section id="hero">
			<img id="hero-img" src="/forest.jpg" alt="Forest" />
			<div id="hero-text">
			  <h1>Welcome to my portfolio!</h1>
			</div>
		  </section>
		<section id="main-content">
			<div id="intro">
				<h1>My name is {cfg.profile.name} and I'm a {cfg.profile.title} at {cfg.profile.company}. I'm currently based in {cfg.profile.location}</h1>
			</div>
			<div id="spotlight">
				<h2>What I'm Up To</h2>
				<p>
					I'm currently focused on the {cfg.spotlight.name}.
					This is a {cfg.spotlight.description}.
				</p>
			</div>
			<div id="projects">
				<h2>What I've Done</h2>
				<ul>
					<li>
						<h3>{cfg.projects[0].name}</h3>
						<p>{cfg.projects[0].description}</p>
					</li>
				</ul>
				<ul>
					<li>
						<h3>{cfg.projects[1].name}</h3>
						<p>{cfg.projects[1].description}</p>
					</li>
				</ul>
			</div>
		</section>
	</div>

</Layout>
<style>
	#hero {
		position: sticky;
		top: 48px; /* match navbar height */
		z-index: 0;
		width: 100%;
		height: 100vh;
	}

	#hero-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	#hero-text {
		position: absolute;
		inset: 0;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 2rem;
		z-index: 1;
	}

	#main-content {
		position: relative;
		z-index: 1;
		background-color: rgb(0, 45, 10); /* match your body bg so it covers the image */
		min-height: 100vh;
		padding: 4rem 2rem;
	}
</style>
