---
import "@fontsource/instrument-serif/400.css";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<h1>Brandon's Wishlist</h1>
		<ol>
            <li><a href="{cfg.profile.links.wishlist.amazonWishlist}">Amazon Wishlist</a></li>
            <li><a href="{cfg.profile.links.wishlist.steamWishlist}">Steam Wishlist</a></li>
        </ol>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100vh;
		background-color:rgb(0, 45, 10);
		color:rgb(242, 242, 242);
		font-family: "Instrument Serif", serif;
        display: flex;
        flex-direction: column;
        align-items: center;
	}
    li {
        padding: 5px;
    }
    li a {
        color:rgb(242, 242, 242);
    }
</style>
