---
import "@fontsource/instrument-serif/400.css";
import Navbar from '../components/navbar.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Brandon's Portfolio</title>
		<meta name="description" content="Brandon Miner's Portfolio">
		<meta name="keywords" content="Brandon, Miner, Portfolio">
		<meta name="author" content="Brandon Miner">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="robots" content="index, follow">
		<meta name="googlebot" content="index, follow">
		<meta name="google" content="notranslate">
	</head>
	<body>
		<Navbar />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color:rgb(0, 45, 10);
		color:rgb(242, 242, 242);
		font-family: "Instrument Serif", serif;
	}
</style>
